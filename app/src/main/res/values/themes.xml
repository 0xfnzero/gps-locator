<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GpsUpdater" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/forest_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/coral_600</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/charcoal_900</item>
        <item name="colorError">@color/danger_600</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_soft</item>
        <item name="colorSecondaryContainer">@color/primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_soft</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/divider</item>
        <item name="colorSurfaceVariant">@color/surface_soft</item>
        <item name="colorOnSurfaceVariant">@color/charcoal_600</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:colorBackground">@color/surface_soft</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Gps.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.Gps.Button</item>
        <item name="textInputStyle">@style/Widget.Gps.Input</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Widget.Gps.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Gps.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Gps.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/surface_soft</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="Widget.Gps.QuickAction" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="android:textColor">@color/on_primary_soft</item>
        <item name="iconTint">@color/on_primary_soft</item>
    </style>
    <style name="ThemeOverlay.Gps.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Gps.Dialog</item>
    </style>
    <style name="ShapeAppearance.Gps.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
